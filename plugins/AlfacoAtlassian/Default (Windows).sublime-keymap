[
    { "keys": ["ctrl+alt+j"], "command": "pretty_json" },
    { "keys": ["ctrl+j", "ctrl+o"], "command": "select_organisation" },
    { "keys": ["ctrl+j", "ctrl+p"], "command": "select_jira_project" },
    { "keys": ["ctrl+j", "o"], "command": "insert_current_organisation" },
    { "keys": ["ctrl+j", "p"], "command": "insert_current_project" },
    { "keys": ["ctrl+j", "ctrl+t"], "command": "select_jira_issue_type" },
    { "keys": ["ctrl+j", "ctrl+r"], "command": "select_jira_parent" },
    { "keys": ["ctrl+j", "ctrl+m"], "command": "reparent_jira_issue" },
    {
        "keys": ["ctrl+shift+j"],
        "command": "init_json_jira",
        "args": { "name": "Packages/AlfacoAtlassian/snippets/jira/jira.sublime-snippet" }
    },
    {
        "keys": ["ctrl+m"],
        "command": "init_markdown_jira",
        "context": [{ "key": "selector", "operator": "equal", "operand": "text.html.markdown" }]
    },
    {
        "keys": ["alt+m"],
        "command": "create_jira_from_markdown"
    },
    {
        "keys": ["ctrl+alt+w"],
        "command": "insert_snippet",
        "args": { "contents": "{\"fields\":${0:$SELECTION}}" }
    },
    { "keys": ["alt+j"], "command": "create_jira_issue" }
]
